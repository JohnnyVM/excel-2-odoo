{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Python environment",
            "type": "shell",
            "windows": {
                "command": "$venv = Join-Path '${workspaceFolder}' '.venv'; $python = Join-Path $venv 'Scripts\\python.exe'; if (-not (Test-Path $python)) { python -m venv $venv }; & $python -m pip install -r (Join-Path '${workspaceFolder}' 'requirements.txt')"
            },
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}
